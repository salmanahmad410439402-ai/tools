{
  "name": "filecraft",
  "version": "1.0.0",
  "private": true,
  "description": "Free PDF and image tools that run privately in your browser.",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "test": "node --experimental-strip-types scripts/smoke-test.mjs",
    "check": "npm run typecheck && npm run validate && npm test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/analytics": "2.0.1",
    "heic2any": "0.0.4",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "mammoth": "^1.13.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2"
  }
}
